# Copy to .env.local and fill in values. Never commit real .env files.

# Root domain for church subdomains: <church>.<ROOT_DOMAIN> serves that church, e.g.
# ROOT_DOMAIN=faithflow.app makes newbreed.faithflow.app serve NewBreed. Leave empty to use
# path URLs only (/newbreed/attendance). <church>.localhost works locally either way.
ROOT_DOMAIN=

# Google Sheets data source (deployments only; local development uses the mock by default).
# The ID of the church's spreadsheet. Use the STAGING copy on preview deployments.
NEWBREED_SPREADSHEET_ID=

# Keyless access through Vercel OIDC and Google Workload Identity Federation. No keys or key files.
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=

# Optional, never on production: "mock" forces the in-memory mock data source,
# "google-sheets" forces Sheets in local development.
DATA_SOURCE_OVERRIDE=
