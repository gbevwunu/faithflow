# Copy to .env.local and fill in values. Never commit real .env files.

# Root domain for church subdomains: <church>.<ROOT_DOMAIN> serves that church, e.g.
# ROOT_DOMAIN=faithflow.app makes newbreed.faithflow.app serve NewBreed. Leave empty to use
# path URLs only (/newbreed/attendance). <church>.localhost works locally either way.
ROOT_DOMAIN=
